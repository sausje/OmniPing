[Unit]
Description=OmniPing ping monitor
Documentation=https://github.com/sausje/OmniPing/blob/main/docs/linux.md
Wants=network-online.target
After=network-online.target

[Service]
Environment=OMNIPING_DATA=/var/lib/omniping
EnvironmentFile=-/etc/default/omniping
ExecStart=/usr/bin/omniping
Restart=on-failure
RestartSec=5

# Runs as a user of its own that systemd makes up; /var/lib/omniping
# belongs to it.
DynamicUser=yes
StateDirectory=omniping

# Permission to ping and to use a port below 1024, and nothing else.
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectHome=yes
PrivateDevices=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
